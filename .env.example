# Copie este arquivo para ".env" e preencha com a chave real.
# O ".env" nunca deve ser commitado (já está no .gitignore).
#
# IMPORTANTE: esta chave só pode ser lida por um backend/serverless function.
# Ela nunca deve aparecer em script.js, index.html ou qualquer arquivo servido
# diretamente ao navegador - isso a exporia publicamente para qualquer visitante.

# Chave da API da FonteData (consulta de CNPJ) - https://fontedata.com
# Enviada no header X-API-Key nas chamadas server-side.
FONTEDATA_API_KEY=

# Opcional: URL de um webhook interno (Slack, Discord, Make, Zapier...) que
# recebe o resultado da consulta de CNPJ. Se deixar vazio, o resultado fica
# só no log de erros do PHP (painel da Locaweb > Estatísticas > Error Log).
INTERNAL_NOTIFY_WEBHOOK_URL=

# Banco MySQL da Locaweb (cPanel > Bancos de Dados MySQL > criar banco e
# usuário, e vincular o usuário ao banco com todas as permissões).
# Depois de criar, rode o schema.sql uma vez no phpMyAdmin.
DB_HOST=localhost
DB_NAME=
DB_USER=
DB_PASS=

# Senha para acessar parceiros-admin.html (a página que lista os cadastros).
ADMIN_TOKEN=

# API REST da Sou+Blu (mesma usada pelo painel principal, ver js/db-connect.js
# no repositório do sistema). Usada para criar automaticamente o usuário
# nível "parceiro" quando um cadastro desta landing page é aprovado.
SOUBLU_API_BASE_URL=
SOUBLU_API_KEY=

# E-mail automático enviado ao parceiro quando o acesso é criado na Sou+Blu
# (login + senha temporária). Usa a função mail() nativa do PHP - já funciona
# na Locaweb sem configuração extra. Se deixar vazio, usa os valores padrão
# abaixo (definidos em api/lib/mailer.php).
#
# Remetente que aparece no e-mail (idealmente um endereço do seu domínio).
MAIL_FROM="SOU + BLU <naoresponda@blupromotora.com.br>"
# Link de login enviado no corpo do e-mail.
SOUBLU_LOGIN_URL=https://soumaisblu.com.br/index.html
